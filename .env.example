# Bale
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=
ALLOW_BALE_WEBHOOK_SETUP=false
FAMILY_ADMIN_SESSION_SECRET=
FAMILY_MEMBER_SESSION_SECRET=
NEXT_PUBLIC_BALE_BOT_USERNAME=My_familybot
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scheduled reminders
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Groq is the default OpenAI-compatible provider)
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# AI_API_KEY is kept as a generic fallback for another OpenAI-compatible provider.
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Voice (server-side ElevenLabs TTS; browser speechSynthesis is fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
