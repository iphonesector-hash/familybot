# Bale
BALE_BOT_TOKEN=
# Secret used only to authorize the protected /api/bale/setup control endpoint.
BALE_WEBHOOK_SETUP_SECRET=
# Dedicated opaque token embedded in the Bale webhook URL. Keep separate from setup/admin secrets.
BALE_WEBHOOK_PATH_TOKEN=
# Legacy fallback only; new production environments should use BALE_WEBHOOK_PATH_TOKEN.
BALE_WEBHOOK_SECRET=
ALLOW_BALE_WEBHOOK_SETUP=false
FAMILY_ADMIN_SESSION_SECRET=
FAMILY_MEMBER_SESSION_SECRET=
NEXT_PUBLIC_BALE_BOT_USERNAME=My_familybot
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scheduled reminders / daily briefing
# Sent only as Authorization: Bearer <CRON_SECRET> or x-cron-secret; never put it in a URL.
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Groq is the default OpenAI-compatible provider)
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# AI_API_KEY is kept as a generic fallback for another OpenAI-compatible provider.
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_MODEL=llama-3.1-8b-instant

# Voice (server-side ElevenLabs Scribe v2 STT + ElevenLabs TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
