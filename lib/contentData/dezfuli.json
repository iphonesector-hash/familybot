  "proverbs": [
    {
      "id": "chamadane-proverb-838",
      "text": "آمَه ، دامَه، اِیان دوامَه",
      "meaning": "اصرار بر انتخاب خود با وجود مخالفت دیگران.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "28f00bfba5e40a2b",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-841",
      "text": "اَ تِر اُفتیدَه، اَ تَنبورَه نَم اُفتهَ",
      "meaning": "توان گذشته را ندارد اما هنوز ادعا می‌کند.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "1ccef1384db87c66",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-847",
      "text": "اَ خُل نِشِسَ خاکِشتَر",
      "meaning": "از گرفتاری به وضع بدتری افتادن.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "71b22d5d0a96b920",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-850",
      "text": "اَر خواجه به بونه ای دو نُونَه ، اَر خواجه به زیره ای دو نونه",
      "meaning": "عوض شدن جایگاه، اصل مسئله را تغییر نمی‌دهد.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "33c7ab52a86259f1",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-853",
      "text": "اَ دَر شَراقِن، اَ حوش هُراقِن",
      "meaning": "ظاهر آراسته، واقعیت دشوار را پنهان می‌کند.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "846f2a817905227f",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-856",
      "text": "اَر بِی نه بیدُمَه، اَما تو بِیّونَه دیدُمَه",
      "meaning": "نداشتن تجربهٔ مستقیم، به معنی بی‌اطلاعی نیست.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "21d1ee5fe3930652",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-862",
      "text": "ار تو دولی، مو بندِ دولُم",
      "meaning": "من هم توانایی و نقش خودم را دارم.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "7fdd2070ee2e8e4b",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-865",
      "text": "اَ ری آیینه اَ پشت سیرمه",
      "meaning": "در حضور خوش‌رفتار و پشت سر بدگو بودن.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "829d1431ebb60607",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-868",
      "text": "اَ کُهِ بکن مَوَن بِجاش",
      "meaning": "برداشت مداوم بدون جبران، بزرگ‌ترین ذخیره را تمام می‌کند.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "cab4f4e626cc6b92",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-871",
      "text": "اَ گوز کویرهَ بایم بوسونی عمل میا ؟",
      "meaning": "از هر چیز باید انتظار متناسب با طبیعتش داشت.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "2a8703bb52398583",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-886",
      "text": "اَ می گلا ، افتید می لیچا",
      "meaning": "از یک گرفتاری به گرفتاری بدتری افتادن.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "33c76b6d0657e79f",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-889",
      "text": "او ا بقون ، بقون اَ تشنی موردن",
      "meaning": "دارندهٔ منبع، خودش از آن بی‌بهره می‌ماند.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "58bb3787eb64d27e",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-892",
      "text": "اوسون که پُختُم کَس نَبید اومَم خوروم جا دَس نبید",
      "meaning": "هنگام زحمت کسی کمک نمی‌کند اما هنگام بهره‌بردن همه حاضرند.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "660327489cfd6ac7",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-895",
      "text": "او سِیو ، گِی، نوبَه",
      "meaning": "رعایت نوبت و حق تقدم دیگران.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "4ce1b6f037244a9b",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-898",
      "text": "اُوشَ نِ اَنَ(اَرنَ) شِنُوگرِ خُوبِیَ",
      "meaning": "فرصت ندارد، وگرنه توان یا میل انجام کار را دارد.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "d5846836bf7db40a",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-901",
      "text": "ای بِندار، خیلی سقا کِپنیدَه",
      "meaning": "این مسیر پیش از تو هم تجربه شده است.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "447849b3e3648762",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-904",
      "text": "ای خَر، ای بون نَم روُوَه",
      "meaning": "انتظار انجام کاری که در توان فرد نیست.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "8708fbba91bb6d56",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-910",
      "text": "ای یَم سَر بُزونِ اُ بُردَه",
      "meaning": "زیان تازه‌ای به زیان قبلی اضافه شده است.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "e900ee103f8092f2",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-913",
      "text": "با تُو نَخشُم بی تُو نمگرم جا",
      "meaning": "نه با حضورش آسوده است و نه با نبودنش.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "1a925bbeeacccdb2",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-919",
      "text": "باهِنده به بال، آدمیزاد به همت",
      "meaning": "پیشرفت انسان به تلاش و همت او وابسته است.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "195f139beefce603",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-955",
      "text": "پَرِ خورَه، مِنجا بِخُفتهَ",
      "meaning": "راحت‌طلبی و بی‌توجهی به زحمت دیگران.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "61c7a35fa5f8e834",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-964",
      "text": "پیاز اَ سَر گَنده بُوَه",
      "meaning": "خرابی از بالاترین بخش آغاز می‌شود.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "9b0c605af684eefc",
      "sourceLabel": "چمدان آبی"
    },
    {
      "id": "chamadane-proverb-970",
      "text": "پیشَ چو، آخِ هِلَه",
      "meaning": "پیش از وقوع مشکل، بی‌تابی و فریاد می‌کند.",
      "source": "چمدان آبی / امثال دزفولی",
      "sourceUrl": "https://chamadaneabi.ir/zarbol-masal-dezfuli/",
      "sourceMode": "verified-import",
      "contentHash": "14382536a281ecbb",
      "sourceLabel": "چمدان آبی"
    }
  ],
  "poems": [
    {
      "id": "dez-wedding-1",
      "text": "حُوشومَه رَشُو کُنُم ، اُتاقُمَه کُنُم فَرش\nمِهمونِه گِرُفتُمَه سَماوَرَ زَنُم تَش",
      "meaning": "بیتی از آواز قدیمی آماده‌کردن خانه برای مهمانان عروسی.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "3bf33702e91f1718",
      "sourceLabel": "دزفولی بیاموزیم"
    },
    {
      "id": "dez-wedding-2",
      "text": "اَر خُــدا نُصـرَت دَهَـــه عروس آیـَه بـِه حوُشُــم\nوَرَقِی طِلا گِرُم بَر سَرِ سُمبــِه کوُشُوم",
      "meaning": "بیتی از آواز قدیمی عروسی دربارهٔ آمدن عروس.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "e6427bf280332e58",
      "sourceLabel": "دزفولی بیاموزیم"
    },
    {
      "id": "dez-wedding-3",
      "text": "دو بــِرار خودُم دارُم دو یَخدونَ مَکـَنزی\nسَرِشونَه وَر دارُم پوشُم حَریر فـَرَنگی",
      "meaning": "بیتی از آواز عروسی؛ در منبع، یخدون مکنزی نوعی چمدان معرفی شده است.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "101d722cc58a6b06",
      "sourceLabel": "دزفولی بیاموزیم"
    },
    {
      "id": "dez-wedding-4",
      "text": "اَزِشون جوومِــه دُوهام مــارُمَه خَلعَتونَــه\nبووَمَه رُوضی کُنُم عَروسشَ آرَه خونَه",
      "meaning": "بخشی از آواز قدیمی مراسم عروسی؛ متن منبع بدون بازسازی گویش.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "85f6a18ddc2578ae",
      "sourceLabel": "دزفولی بیاموزیم"
    },
    {
      "id": "dez-wedding-5",
      "text": "چرخِ بازار چرخِ بازار سیزَنِت بایا طِلا\nجومَه دومانَه تُو دُختی زَندیـِش دُکمِه طِلا",
      "meaning": "بیتی از آواز عروسی دربارهٔ دوختن لباس داماد.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "4f033b184a34c5e9",
      "sourceLabel": "دزفولی بیاموزیم"
    },
    {
      "id": "dez-wedding-6",
      "text": "اَ خُدا سُو وایَه دارُم، اَوَّلی حُوشِ گـَپی\nدوّمی ماشینِ دُووی، سوّمی دَسَه چَکِی",
      "meaning": "بخشی از آواز قدیمی عروسی با بیان آرزوها.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "f9778ae8a2abc8f6",
      "sourceLabel": "دزفولی بیاموزیم"
    },
    {
      "id": "dez-wedding-7",
      "text": "بیُو بَرِیمِش بیُو بَرِیمِش ..تا نَکَندِن چارِشَه\nجورابِی ساقَه بُلَندِی عَوَضِه دُلاقِشَه",
      "meaning": "بخشی از آواز مراسم عروسی؛ نقل مستقیم از منبع.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "4aa9d62f634ff19b",
      "sourceLabel": "دزفولی بیاموزیم"
    },
    {
      "id": "dez-wedding-8",
      "text": "پُلَ بَندِی پُلَ بَندِی پِه مَفتیلا طِلا\nهَر کُجا دووما گُذَردَه مُوشَلا نُومِ خُدا",
      "meaning": "بیتی از آواز مراسم عروسی برای همراهی داماد.",
      "source": "آواز قدیمی عروسی / دزفولی بیاموزیم",
      "sourceUrl": "https://t.me/dezfuli_biamoozim/797",
      "sourceMode": "verified-import",
      "sourceGroup": "traditional-wedding-song",
      "contentHash": "451fb6b4d8b9a91c",
      "sourceLabel": "دزفولی بیاموزیم"
    }
  ]
}
